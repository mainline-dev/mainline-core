<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mainline</title>
  <%== og_tags %>
  <%== assets(:css) %>
  <style>@import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap');</style>
</head>
<body class="landing">
<%== render('site/_nav') %>
  <div class="hero">
    <div class="login-brand">Main<em>line</em></div>
    <p class="login-tagline">Where Agile theatre goes to die.</p>
    <div class="login-rule"></div>
    <% if flash['error'] %>
      <div class="flash flash-error" role="alert" data-test-id="flash-error"><%= flash['error'] %></div>
    <% end %>
    <% if flash['notice'] %>
      <div class="flash" role="alert" data-test-id="flash-notice"><%= flash['notice'] %></div>
    <% end %>
    <h2 class="login-heading">Reset your password</h2>
    <form method="post" action="/forgot-password" class="email-auth-form" aria-label="Reset your password" data-test-id="forgot-password-form">
      <%== csrf_tag('/forgot-password') %>
      <label for="reset-email">Email</label>
      <input type="email" id="reset-email" name="email" required autocomplete="email" maxlength="254">
      <button type="submit">Send login link</button>
    </form>
    <p class="login-back"><a href="/login">Back to sign in</a></p>
  </div>
</body>
</html>
