<li data-id="<%= @activity.id %>" id="activity-<%= @activity.id %>">
  <span class="drag-handle"><svg width="10" height="16" viewBox="0 0 10 16" fill="currentColor"><circle cx="2.5" cy="2.5" r="1.5"/><circle cx="7.5" cy="2.5" r="1.5"/><circle cx="2.5" cy="8" r="1.5"/><circle cx="7.5" cy="8" r="1.5"/><circle cx="2.5" cy="13.5" r="1.5"/><circle cx="7.5" cy="13.5" r="1.5"/></svg></span>
  <strong><%= @activity.name %></strong>
  <a href="/maps/<%= @map.id %>/activities/<%= @activity.id %>/edit"
     hx-get="/maps/<%= @map.id %>/activities/<%= @activity.id %>/edit"
     hx-target="#activity-<%= @activity.id %>" hx-swap="outerHTML"
     class="btn-link">Edit</a>
</li>
