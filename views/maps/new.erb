<h1 class="page-title">New Map</h1>

<% if @errors&.any? %>
  <ul class="errors" data-test-id="form-errors"><% @errors.each do |e| %><li><%= e %></li><% end %></ul>
<% end %>

<div class="form-container">
  <form method="post" action="/maps">
    <%== csrf_tag('/maps') %>

    <label for="name">Name</label>
    <input type="text" id="name" name="name" value="<%= @map_name %>"
           placeholder="e.g. Product Map" maxlength="100" autofocus>

    <button type="submit" class="btn">Create Map</button>
    <a href="/teams/<%= @current_team.id %>" class="cancel-link">Cancel</a>
  </form>
</div>
