<%
  assign_count = @story.story_assignments.length
  pairing_label = if @story.status == 'released'
                    'released'
                  elsif @story.status == 'planned'
                    'planned'
                  elsif assign_count >= 3
                    'ensemble'
                  elsif assign_count == 2
                    'paired'
                  elsif assign_count == 1
                    'solo'
                  else
                    @story.status
                  end
  task = @story.task
  activity = task ? Activity[task.activity_id] : nil
%>
<div class="story-expand-backdrop" data-test-id="panel-backdrop"></div>
<div class="story-expand" data-test-id="panel-preview">
  <div class="story-expand-bar">
    <div class="story-expand-meta">
      <span class="state-label state-<%= pairing_label %>"><%= pairing_label %></span>
      <% if activity && task %>
        <span class="story-expand-path"><%= activity.name %> / <%= task.name %></span>
      <% end %>
    </div>
    <button type="button" class="preview-copy-id" data-story-id="<%= @story.id %>" data-test-id="copy-story-id"><%= @story.id[0, 8].upcase %></button>
  </div>

  <div id="story-expand-body" class="story-expand-body">
    <h1 class="story-expand-title"><%= @story.title %></h1>

    <% if @story.story_assignments.any? %>
      <div class="story-expand-assignees">
        <% @story.story_assignments.each do |sa| %>
          <span class="story-expand-person"><%= sa.person.name %></span>
        <% end %>
      </div>
    <% end %>

    <% scenarios = @story.scenarios %>
    <% if scenarios.any? %>
      <ol class="story-expand-scenarios">
        <% scenarios.each do |sc| %>
          <li class="story-expand-scenario">
            <div><span class="story-expand-kw">Given</span> <%= sc.given_text %></div>
            <div><span class="story-expand-kw">When</span> <%= sc.when_text %></div>
            <div><span class="story-expand-kw">Then</span> <%= sc.then_text %></div>
          </li>
        <% end %>
      </ol>
    <% end %>
  </div>
</div>
<div class="slide-panel" data-test-id="story-panel" role="dialog" aria-modal="true" aria-label="Edit story">
  <div class="slide-panel-header">
    <h2 class="slide-panel-title"><%= @story.status == 'released' ? 'Edit Decoupling' : 'Edit Story' %></h2>
    <button type="button" class="slide-panel-close" data-test-id="panel-close" aria-label="Close">&times;</button>
  </div>
  <div class="slide-panel-body">
    <%
      split_children = Story.where(split_from_id: @story.id, archived_at: nil).order(:position).all
      panel_href = lambda { |sid| "/maps/#{@map.id}/stories/#{sid}/edit" }
    %>
    <% if @story.split_from_id && @story.split_from %>
      <p class="story-provenance">
        <a data-test-id="split-from-link" href="<%= panel_href.call(@story.split_from_id) %>">Split from "<%= @story.split_from.title %>"</a>
      </p>
    <% end %>
    <% split_children.each do |child| %>
      <p class="story-provenance">
        <a data-test-id="split-to-link" href="<%= panel_href.call(child.id) %>">Split to "<%= child.title %>"</a>
      </p>
    <% end %>
      <%== render('maps/stories/_edit_form') %>

      <% @scenario_errors = [] %>
      <%== render('maps/stories/_scenarios') %>
  </div>
</div>
