<aside id="story-preview" class="story-preview">
  <div class="preview-header">
    <h2 class="preview-title"><%= @story.title %></h2>
    <button type="button" class="preview-copy-id" data-story-id="<%= @story.id %>" data-test-id="copy-story-id"><%= @story.id[0, 8].upcase %></button>
  </div>
  <% scenarios = @story.scenarios %>
  <% if scenarios.any? %>
    <ol class="preview-scenarios">
      <% scenarios.each do |sc| %>
        <li class="preview-scenario">
          <div class="scenario-name"><%= sc.display_name %></div>
          <div><span class="preview-kw">Given</span> <%= sc.given_text %></div>
          <div><span class="preview-kw">When</span> <%= sc.when_text %></div>
          <div><span class="preview-kw">Then</span> <%= sc.then_text %></div>
        </li>
      <% end %>
    </ol>
  <% end %>
</aside>
