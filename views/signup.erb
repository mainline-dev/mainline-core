<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign up - Mainline</title>
  <meta name="description" content="Start Mainline free: a 14-day team trial with no card, or self-host it free. Or get the free CI monitor for GitHub with no paid plan needed.">
  <%== og_tags %>
  <%== assets(:css) %>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap');
    /* A field only bots fill in: off screen, out of the tab order, hidden from screen readers. */
    .signup-website { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
    .signup-trial h2 {
      font-family: var(--font-mono);
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--text-primary);
      margin: 0 0 0.25rem;
    }
    .signup-trial-sub {
      font-size: 0.8125rem;
      color: var(--text-tertiary);
      margin: 0;
    }
    .signup-receipts {
      display: flex;
      justify-content: center;
      gap: 1.25rem;
      list-style: none;
      padding: 0;
      margin: 1.5rem 0 0;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-tertiary);
    }
    .signup-receipts .dot {
      display: inline-block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent-emerald);
      margin-right: 0.4rem;
      vertical-align: middle;
    }
    .signup-monitor {
      border-top: 1px solid var(--border-subtle);
      max-width: 320px;
      margin: 2.5rem auto 0;
      padding: 2rem 0 0;
      text-align: center;
    }
    .signup-monitor h3 {
      font-family: var(--font-mono);
      font-size: 0.9375rem;
      font-weight: 600;
      color: var(--text-secondary);
      margin: 0 0 0.375rem;
    }
    .signup-monitor p {
      font-size: 0.8125rem;
      color: var(--text-tertiary);
      margin: 0 0 1rem;
      line-height: 1.5;
    }
    .signup-monitor-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1.25rem;
      background: transparent;
      color: var(--accent-cyan);
      border: 1px solid var(--accent-cyan-dim);
      border-radius: 6px;
      font-family: var(--font-body);
      font-size: 0.8125rem;
      font-weight: 500;
      text-decoration: none;
      transition: background 0.15s ease, border-color 0.15s ease;
    }
    .signup-monitor-cta:hover {
      background: var(--accent-cyan-bg);
      border-color: var(--accent-cyan);
    }
    .signup-monitor-cta svg {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }
  </style>
  <%== public_head_tags %>
</head>
<body class="landing">
<%== render('site/_nav') %>
  <div class="hero">
    <div class="login-brand">Main<em>line</em></div>

    <% if flash['error'] %>
      <div class="flash flash-error" role="alert" data-test-id="flash-error"><%= flash['error'] %></div>
    <% end %>
    <% if flash['notice'] %>
      <div class="flash" role="alert" data-test-id="flash-notice"><%= flash['notice'] %></div>
    <% end %>

    <section class="signup-trial">
      <h2>Create your account</h2>
      <div class="auth-buttons">
        <% if SignInProviders.enabled?('google_oauth2') %>
        <form method="post" action="/auth/google_oauth2">
          <input type="hidden" name="authenticity_token" value="<%= @authenticity_token %>">
          <button type="submit" class="auth-btn">
            <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
            Continue with Google
          </button>
        </form>
        <% end %>
        <% if SignInProviders.enabled?('github') %>
        <form method="post" action="/auth/github">
          <input type="hidden" name="authenticity_token" value="<%= @authenticity_token %>">
          <button type="submit" class="auth-btn">
            <svg viewBox="0 0 24 24"><path fill="#e8e8f0" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.341-3.369-1.341-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.337-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"/></svg>
            Continue with GitHub
          </button>
        </form>
        <% end %>
        <% if SignInProviders.enabled?('gitlab') %>
        <form method="post" action="/auth/gitlab">
          <input type="hidden" name="authenticity_token" value="<%= @authenticity_token %>">
          <button type="submit" class="auth-btn">
            <svg viewBox="0 0 24 24"><path fill="#E24329" d="m12 21.42-3.27-10.06h6.54L12 21.42z"/><path fill="#FC6D26" d="m12 21.42-3.27-10.06H2.38L12 21.42z"/><path fill="#FCA326" d="M2.38 11.36 1.16 15.1a.83.83 0 0 0 .3.93L12 21.42 2.38 11.36z"/><path fill="#E24329" d="M2.38 11.36h6.35L6.15 3.05a.42.42 0 0 0-.79 0L2.38 11.36z"/><path fill="#FC6D26" d="m12 21.42 3.27-10.06h6.35L12 21.42z"/><path fill="#FCA326" d="m21.62 11.36 1.22 3.74a.83.83 0 0 1-.3.93L12 21.42l9.62-10.06z"/><path fill="#E24329" d="M21.62 11.36h-6.35l2.58-8.31a.42.42 0 0 1 .79 0l2.98 8.31z"/></svg>
            Continue with GitLab
          </button>
        </form>
        <% end %>
      </div>
      <% if SignInProviders.any? %>
        <p class="signup-trial-sub" style="margin-top: 0.75rem;">Sign-in only. No access to your code.</p>
      <% end %>
      <% if SignInProviders.any? %>
        <div class="login-divider">or</div>
      <% end %>
      <form method="post" action="/signup" class="email-auth-form" aria-label="Create an account" data-test-id="email-signup-form">
        <%== csrf_tag('/signup') %>
        <input type="hidden" name="form_started" value="<%= @form_started %>">
        <label for="signup-name">Name</label>
        <input type="text" id="signup-name" name="name" required autocomplete="name" minlength="2" maxlength="100">
        <label for="signup-email">Email</label>
        <input type="email" id="signup-email" name="email" required autocomplete="email" maxlength="254">
        <label for="signup-password">Password</label>
        <input type="password" id="signup-password" name="password" required autocomplete="new-password" minlength="12" maxlength="70">
        <div class="signup-website" aria-hidden="true">
          <label for="signup-website">Leave this empty</label>
          <input type="text" id="signup-website" name="website" tabindex="-1" autocomplete="off" data-test-id="signup-website">
        </div>
        <button type="submit">Sign up with email</button>
      </form>
    </section>

    <p class="login-new">Already have an account? <a href="/login">Sign in</a></p>
  </div>
<script nonce="<%= @csp_nonce %>">
(function() {
  function track(name, data) { document.dispatchEvent(new CustomEvent('mainline:track', { detail: { name: name, data: data } })); }

  document.querySelectorAll('.auth-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var provider = btn.textContent.trim().replace('Continue with ', '').toLowerCase();
      track('signup-auth', { provider: provider });
    });
  });

})();
</script>
</body>
</html>
