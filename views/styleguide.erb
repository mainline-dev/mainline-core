<div data-test-id="styleguide">

<h1 class="page-title">Style Guide</h1>
<p class="page-subtitle">Living reference for the Mainline design system</p>

<div class="section">
  <h2 class="section-title">Color Palette</h2>

  <h3 style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.06em; margin: 1rem 0 0.5rem;">Backgrounds</h3>
  <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.5rem;">
    <div style="background: var(--bg-base); border: 1px solid var(--border-default); border-radius: 4px; padding: 1.5rem 0.75rem 0.5rem; text-align: center;">
      <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-secondary);">bg-base</span>
    </div>
    <div style="background: var(--bg-surface); border: 1px solid var(--border-default); border-radius: 4px; padding: 1.5rem 0.75rem 0.5rem; text-align: center;">
      <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-secondary);">bg-surface</span>
    </div>
    <div style="background: var(--bg-raised); border: 1px solid var(--border-default); border-radius: 4px; padding: 1.5rem 0.75rem 0.5rem; text-align: center;">
      <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-secondary);">bg-raised</span>
    </div>
    <div style="background: var(--bg-overlay); border: 1px solid var(--border-default); border-radius: 4px; padding: 1.5rem 0.75rem 0.5rem; text-align: center;">
      <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-secondary);">bg-overlay</span>
    </div>
    <div style="background: var(--bg-hover); border: 1px solid var(--border-default); border-radius: 4px; padding: 1.5rem 0.75rem 0.5rem; text-align: center;">
      <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-secondary);">bg-hover</span>
    </div>
  </div>

  <h3 style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.06em; margin: 1.5rem 0 0.5rem;">Accent Colors</h3>
  <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.5rem;">
    <div style="border-radius: 4px; overflow: hidden; border: 1px solid var(--border-default);">
      <div style="background: var(--accent-cyan); height: 2.5rem;"></div>
      <div style="background: var(--accent-cyan-dim); height: 1rem;"></div>
      <div style="background: var(--accent-cyan-bg); padding: 0.375rem; text-align: center;">
        <span style="font-family: var(--font-mono); font-size: 0.6rem; color: var(--accent-cyan);">cyan</span>
      </div>
    </div>
    <div style="border-radius: 4px; overflow: hidden; border: 1px solid var(--border-default);">
      <div style="background: var(--accent-emerald); height: 2.5rem;"></div>
      <div style="background: var(--accent-emerald-dim); height: 1rem;"></div>
      <div style="background: var(--accent-emerald-bg); padding: 0.375rem; text-align: center;">
        <span style="font-family: var(--font-mono); font-size: 0.6rem; color: var(--accent-emerald);">emerald</span>
      </div>
    </div>
    <div style="border-radius: 4px; overflow: hidden; border: 1px solid var(--border-default);">
      <div style="background: var(--accent-amber); height: 2.5rem;"></div>
      <div style="background: var(--accent-amber-dim); height: 1rem;"></div>
      <div style="background: var(--accent-amber-bg); padding: 0.375rem; text-align: center;">
        <span style="font-family: var(--font-mono); font-size: 0.6rem; color: var(--accent-amber);">amber</span>
      </div>
    </div>
    <div style="border-radius: 4px; overflow: hidden; border: 1px solid var(--border-default);">
      <div style="background: var(--accent-red); height: 2.5rem;"></div>
      <div style="background: var(--accent-red-dim); height: 1rem;"></div>
      <div style="background: var(--accent-red-bg); padding: 0.375rem; text-align: center;">
        <span style="font-family: var(--font-mono); font-size: 0.6rem; color: var(--accent-red);">red</span>
      </div>
    </div>
    <div style="border-radius: 4px; overflow: hidden; border: 1px solid var(--border-default);">
      <div style="background: var(--accent-violet); height: 2.5rem;"></div>
      <div style="background: var(--accent-violet-dim); height: 1rem;"></div>
      <div style="background: var(--accent-violet-bg); padding: 0.375rem; text-align: center;">
        <span style="font-family: var(--font-mono); font-size: 0.6rem; color: var(--accent-violet);">violet</span>
      </div>
    </div>
    <div style="border-radius: 4px; overflow: hidden; border: 1px solid var(--border-default);">
      <div style="background: var(--accent-blue); height: 2.5rem;"></div>
      <div style="background: var(--accent-blue); height: 1rem; opacity: 0.6;"></div>
      <div style="background: var(--accent-blue-bg); padding: 0.375rem; text-align: center;">
        <span style="font-family: var(--font-mono); font-size: 0.6rem; color: var(--accent-blue);">blue</span>
      </div>
    </div>
  </div>

  <h3 style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.06em; margin: 1.5rem 0 0.5rem;">Text</h3>
  <div style="display: flex; gap: 2rem;">
    <span style="color: var(--text-primary); font-size: 0.85rem;">Primary</span>
    <span style="color: var(--text-secondary); font-size: 0.85rem;">Secondary</span>
    <span style="color: var(--text-tertiary); font-size: 0.85rem;">Tertiary</span>
    <span style="background: var(--text-primary); color: var(--text-inverse); padding: 0.125rem 0.5rem; border-radius: 3px; font-size: 0.85rem;">Inverse</span>
  </div>

  <h3 style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.06em; margin: 1.5rem 0 0.5rem;">Borders</h3>
  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem;">
    <div style="border: 2px solid var(--border-subtle); border-radius: 4px; padding: 0.75rem; text-align: center;">
      <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-tertiary);">subtle</span>
    </div>
    <div style="border: 2px solid var(--border-default); border-radius: 4px; padding: 0.75rem; text-align: center;">
      <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-tertiary);">default</span>
    </div>
    <div style="border: 2px solid var(--border-strong); border-radius: 4px; padding: 0.75rem; text-align: center;">
      <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-tertiary);">strong</span>
    </div>
    <div style="border: 2px solid var(--border-focus); border-radius: 4px; padding: 0.75rem; text-align: center;">
      <span style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-tertiary);">focus</span>
    </div>
  </div>
</div>

<div class="section">
  <h2 class="section-title">Typography</h2>

  <div style="margin-bottom: 1.5rem;">
    <p style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 0.25rem;">Mono - JetBrains Mono</p>
    <p style="font-family: var(--font-mono); font-size: 1.25rem; font-weight: 700; margin: 0;">The quick brown fox jumps over the lazy dog</p>
    <p style="font-family: var(--font-mono); font-size: 1rem; font-weight: 600; margin: 0.25rem 0 0;">Semi-bold weight for headings and labels</p>
    <p style="font-family: var(--font-mono); font-size: 0.85rem; font-weight: 400; margin: 0.25rem 0 0; color: var(--text-secondary);">Regular weight for data and code</p>
  </div>

  <div>
    <p style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 0.25rem;">Body - Source Sans 3</p>
    <p style="font-family: var(--font-body); font-size: 1.25rem; font-weight: 700; margin: 0;">The quick brown fox jumps over the lazy dog</p>
    <p style="font-family: var(--font-body); font-size: 1rem; font-weight: 600; margin: 0.25rem 0 0;">Semi-bold for body emphasis and card titles</p>
    <p style="font-family: var(--font-body); font-size: 0.875rem; font-weight: 400; margin: 0.25rem 0 0; color: var(--text-secondary);">Regular weight for body text and descriptions</p>
  </div>

  <div style="margin-top: 1.5rem;">
    <p style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 0.5rem;">Heading Scale</p>
    <h1 class="page-title" style="margin: 0;">Page Title (1.125rem mono 700)</h1>
    <h2 class="section-title" style="margin: 0.75rem 0 0;">Section Title (0.8rem mono 600)</h2>
    <h3 class="section-heading" style="margin: 0.75rem 0 0;">Section Heading (1rem mono 600)</h3>
  </div>
</div>

<div class="section">
  <h2 class="section-title">Buttons</h2>
  <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
    <button type="button" class="btn">Primary</button>
    <button type="button" class="btn" disabled>Disabled</button>
    <button type="button" class="btn btn-saved">Saved</button>
    <button type="button" class="btn btn-danger">Danger</button>
    <button type="button" class="btn btn-sm">Small</button>
    <button type="button" class="btn-link">Link Button</button>
  </div>

  <div style="margin-top: 1rem; display: flex; gap: 0.75rem; align-items: center;">
    <button type="button" class="deploy-btn">Deploy</button>
    <button type="button" class="release-btn">Release</button>
    <button type="button" class="archive-btn">Archive</button>
    <button type="button" class="footer-action">Footer Action</button>
  </div>
</div>

<div class="section">
  <h2 class="section-title">State Labels</h2>
  <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
    <span class="state-label state-planned">Planned</span>
    <span class="state-label state-solo">Solo</span>
    <span class="state-label state-paired">Paired</span>
    <span class="state-label state-ensemble">Ensemble</span>
    <span class="state-label state-released">Released</span>
  </div>
</div>

<div class="section">
  <h2 class="section-title">Badges</h2>
  <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
    <span class="persona-badge">Customer</span>
    <span class="persona-badge">Admin</span>
    <span class="assignee-badge">Alice</span>
    <span class="assignee-badge">Bob</span>
    <span class="decoupling-badge decoupling-flag">FF</span>
    <span class="decoupling-badge decoupling-bba">BBA</span>
    <span class="decoupling-badge decoupling-dark_launch">DL</span>
  </div>
</div>

<div class="section">
  <h2 class="section-title">Story Cards</h2>
  <div style="display: grid; grid-template-columns: repeat(3, minmax(200px, 280px)); gap: 1rem;">
    <div class="story-card">
      <div class="card-header">
        <span class="state-label state-planned">Planned</span>
      </div>
      <div class="card-body">Keyword search with autocomplete</div>
      <div class="card-footer">
        <div class="card-footer-row" style="opacity: 1;">
          <button type="button" class="deploy-btn">Deploy</button>
          <button type="button" class="release-btn">Release</button>
        </div>
      </div>
    </div>

    <div class="story-card">
      <div class="card-header">
        <span class="state-label state-paired">Paired</span>
      </div>
      <div class="card-body">Filter catalogue by price range</div>
      <div class="card-labels">
        <div style="display: flex; gap: 0.25rem; flex-wrap: wrap;">
          <span class="assignee-badge">Alice</span>
          <span class="assignee-badge">Bob</span>
        </div>
      </div>
      <div class="card-footer">
        <div class="card-footer-row" style="opacity: 1;">
          <button type="button" class="deploy-btn">Deploy</button>
          <button type="button" class="release-btn">Release</button>
        </div>
        <div class="card-footer-row">
          <span class="card-split-notice" style="animation: none;">Split candidate</span>
        </div>
      </div>
    </div>

    <div class="story-card story-released">
      <div class="card-header">
        <span class="state-label state-released">Released</span>
      </div>
      <div class="card-body">Sort results by relevance</div>
      <div class="card-footer">
        <div class="card-footer-row" style="opacity: 1;">
          <span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-tertiary);">2 deploys</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="section">
  <h2 class="section-title">Flash Messages</h2>
  <div style="display: flex; flex-direction: column; gap: 0.75rem; max-width: 480px;">
    <div class="flash" style="position: static; transform: none;">Map 'Product Map' created</div>
    <div class="flash flash-error" style="position: static; transform: none;">Your team has reached its map limit</div>
    <div class="banner-info">Only fire this webhook after a production deploy.</div>
    <div class="warning-text">This action cannot be undone.</div>
  </div>
</div>

<div class="section">
  <h2 class="section-title">Forms</h2>
  <div class="form-container">
    <label>Text Input</label>
    <input type="text" value="Story name" readonly>

    <label>Email Input</label>
    <input type="email" value="alice@example.com" readonly>

    <label>Textarea</label>
    <textarea readonly>As a customer, I want to search by keyword so that I can find products quickly.</textarea>

    <label>Select</label>
    <select disabled>
      <option>Choose an option</option>
    </select>

    <div class="checkbox-group">
      <label><input type="checkbox" checked disabled> Active filter</label>
      <label><input type="checkbox" disabled> Slices view</label>
    </div>

    <button type="button" class="btn" style="margin-top: 1rem;">Save</button>
    <a href="#" class="cancel-link">Cancel</a>
  </div>
</div>

<div class="section">
  <h2 class="section-title">Navigation</h2>
  <div class="subnav" style="max-width: 480px;">
    <a href="#" class="subnav-link active">Map</a>
    <a href="#" class="subnav-link">Edit</a>
    <a href="#" class="subnav-link">History</a>
    <a href="#" class="subnav-action">Add Story</a>
  </div>
  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
    <a href="#" class="filter-toggle active" aria-current="true">Active Only</a>
    <a href="#" class="filter-toggle">Slices</a>
    <a href="#" class="filter-toggle">Hide Released</a>
  </div>
</div>

<div class="section">
  <h2 class="section-title">Cards</h2>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem;">
    <a href="#" class="map-card" style="text-decoration: none;">
      <span class="map-card-name">Product Map</span>
      <span class="map-card-meta">3 activities, 8 stories</span>
      <span class="map-card-members">Alice, Bob</span>
      <span class="map-card-updated">Updated 2 hours ago</span>
    </a>
    <div class="persona-card">
      <div class="persona-card-header">
        <span class="persona-card-name">Customer</span>
        <a href="#" class="persona-card-edit">Edit</a>
      </div>
      <p class="persona-card-desc">End users browsing and purchasing products</p>
      <div class="persona-card-activities">
        <span class="persona-badge">Browse</span>
        <span class="persona-badge">Search</span>
        <span class="persona-badge">Purchase</span>
      </div>
    </div>
  </div>
</div>

<div class="section">
  <h2 class="section-title">Shadows</h2>
  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem;">
    <div style="background: var(--bg-raised); border-radius: 4px; padding: 1.5rem; text-align: center; box-shadow: var(--shadow-sm);">
      <span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-secondary);">shadow-sm</span>
    </div>
    <div style="background: var(--bg-raised); border-radius: 4px; padding: 1.5rem; text-align: center; box-shadow: var(--shadow-md);">
      <span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-secondary);">shadow-md</span>
    </div>
    <div style="background: var(--bg-raised); border-radius: 4px; padding: 1.5rem; text-align: center; box-shadow: var(--shadow-lg);">
      <span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-secondary);">shadow-lg</span>
    </div>
  </div>
  <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; margin-top: 1rem;">
    <div style="background: var(--bg-raised); border-radius: 4px; padding: 1.5rem; text-align: center; box-shadow: var(--shadow-glow-cyan);">
      <span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--accent-cyan);">glow-cyan</span>
    </div>
    <div style="background: var(--bg-raised); border-radius: 4px; padding: 1.5rem; text-align: center; box-shadow: var(--shadow-glow-emerald);">
      <span style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--accent-emerald);">glow-emerald</span>
    </div>
  </div>
</div>

<div class="section">
  <h2 class="section-title">Data Table</h2>
  <table class="data-table" style="max-width: 480px;">
    <thead>
      <tr><th>Name</th><th>Role</th><th>Stories</th></tr>
    </thead>
    <tbody>
      <tr><td>Alice</td><td>Developer</td><td>12</td></tr>
      <tr><td>Bob</td><td>Developer</td><td>9</td></tr>
      <tr><td>Carol</td><td>Designer</td><td>7</td></tr>
    </tbody>
  </table>
</div>

<div class="section">
  <h2 class="section-title">Scenarios</h2>
  <div style="max-width: 480px;">
    <div class="scenario-row">
      <div class="scenario-form">
        <span class="scenario-label">Given</span>
        <input type="text" class="scenario-input" value="I am on the search page" readonly>
        <span class="scenario-label">When</span>
        <input type="text" class="scenario-input" value="I type 'widget'" readonly>
        <span class="scenario-label">Then</span>
        <input type="text" class="scenario-input" value="I see matching results" readonly>
      </div>
    </div>
  </div>
</div>

<div class="section">
  <h2 class="section-title">Empty State</h2>
  <p class="empty-state">No stories yet. Create one to get started.</p>
</div>

</div>
