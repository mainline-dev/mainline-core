<% team_path = "/teams/#{@team.id}" %>
<% map_path = @maps.any? ? "/maps/#{@maps.first.id}" : '/maps/new' %>
<%
  # Someone not working on the team's stories joins before they can start a map.
  start_actions = if @is_working_member
                    [['New map', '/maps/new', 'first-run-new-map'], ['Import', "#{team_path}/museum/import", 'first-run-import']]
                  else
                    [['Join as a working member', "#{team_path}/account", 'first-run-join']]
                  end
  steps = [
    [:map, 'Start your map.', 'Begin with a new map, or import a Jira CSV or a Mainline file into the Ticket Museum.', start_actions],
    [:promote, "Pull what's real.", "Promote the work you'd start in the next few weeks onto the map.", [['Open the museum', "#{team_path}/museum", nil]]],
    [:slice, 'Shape it into a map.', 'Arrange the stories under the activities they serve, and slice the first release.', [['Open the map', map_path, nil]]],
    [:start, 'One story each.', 'Each person starts one story, and nobody starts a second until the first is released.', [['Open the map', map_path, nil]]],
    [:agent, 'Connect your coding agent (optional).', 'It reads one story at a time over MCP.', [['Get an MCP token', "/profile/coding-agents?team=#{@team.id}", 'first-run-coding-agent']]]
  ]
  # Once the steps every team needs are done, the list folds into one line
  # about the figure. The figure only ever comes for a team with a Jira
  # backlog in its museum: without one there is no line, and nothing to show.
  settled = @first_run_settled
  percent = @never_pulled
  due = @never_pulled_due&.getutc&.to_date
%>
<% if !settled || percent || due %>
<section class="section first-run<%= ' is-settled' if settled %>" data-test-id="first-run" data-settled="<%= settled %>">
  <% if settled %>
    <details class="first-run-more">
      <summary class="first-run-summary" data-test-id="first-run-figure"<% if percent %> data-percent="<%= percent %>"<% else %> data-due="<%= due.iso8601 %>"<% end %>>
        <% if percent %>
          <b>After <%= NeverPulled::AFTER_DAYS %> days, <%= percent %>% of this backlog has never been pulled.</b>
          <a href="<%= team_path %>/museum" class="first-run-action" data-test-id="first-run-museum">Open the museum</a>
        <% else %>
          <b>First steps done.</b> On <time datetime="<%= due.iso8601 %>"><%= due.strftime('%-d %B') %></time> the Ticket Museum will say how much of this backlog was never pulled.
        <% end %>
      </summary>
  <% else %>
    <p class="first-run-lead">Most backlogs hold far more than any team will ever finish. Let's find out what's real.</p>
  <% end %>
  <ol class="first-run-steps">
    <% steps.each_with_index do |(key, title, text, actions), n| %>
      <% done = @first_run.fetch(key) %>
      <li class="first-run-step<%= ' is-done' if done %>" data-test-id="first-run-step" data-step="<%= key %>" data-done="<%= done %>">
        <span class="first-run-tick"><%= done ? "✓" : n + 1 %></span>
        <span class="first-run-text"><b><%= title %></b><% unless done %> <%= text %><% end %></span>
        <% unless done %><span class="first-run-actions"><% actions.each do |label, path, test_id| %><a href="<%= path %>" class="first-run-action"<% if test_id %> data-test-id="<%= test_id %>"<% end %>><%= label %></a><% end %></span><% end %>
      </li>
    <% end %>
    <% if !settled && (percent || due) %>
      <li class="first-run-step first-run-wait" data-test-id="first-run-step" data-step="figure" data-done="<%= @first_run.fetch(:figure) %>">
        <% if percent %>
          <span class="first-run-text" data-test-id="first-run-figure" data-percent="<%= percent %>"><b>After <%= NeverPulled::AFTER_DAYS %> days, <%= percent %>% of this backlog has never been pulled.</b></span>
          <span class="first-run-actions"><a href="<%= team_path %>/museum" class="first-run-action" data-test-id="first-run-museum">Open the museum</a></span>
        <% else %>
          <span class="first-run-text" data-test-id="first-run-figure" data-due="<%= due.iso8601 %>">On <time datetime="<%= due.iso8601 %>"><%= due.strftime('%-d %B') %></time> the Ticket Museum will say how much of this backlog was never pulled.</span>
        <% end %>
      </li>
    <% end %>
  </ol>
  <% if settled %></details><% end %>
</section>
<% end %>
