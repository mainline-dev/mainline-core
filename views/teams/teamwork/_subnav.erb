<nav class="subnav">
  <% tw_base = "/teams/#{@team.id}/teamwork" %>
  <a href="<%= tw_base %>"
     class="subnav-link<%= ' active' if @active_tab == 'matrix' %>">Matrix</a>
  <a href="<%= tw_base %>/ensemble"
     class="subnav-link<%= ' active' if @active_tab == 'ensemble' %>">Ensemble</a>
  <a href="<%= tw_base %>/solo"
     class="subnav-link<%= ' active' if @active_tab == 'solo' %>">Solo</a>
  <%# A walkthrough needs a second person, so a team of one has no tab for them. %>
  <% if @members.size >= 2 %>
    <a href="<%= tw_base %>/walkthroughs" data-test-id="teamwork-tab-walkthroughs"
       class="subnav-link<%= ' active' if @active_tab == 'walkthroughs' %>">Walkthroughs</a>
  <% end %>
</nav>
