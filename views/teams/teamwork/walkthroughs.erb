<% @page_breadcrumb = 'Teamwork' %>
<%== render('teams/teamwork/_subnav') %>

<div class="teamwork-layout">
  <div class="teamwork-main">
    <h2 class="section-heading" data-test-id="teamwork-page-walkthroughs">Walkthroughs</h2>

    <% unless @rule_on %>
      <p class="lens-help" data-test-id="walkthrough-rule-off">The two-person rule is off for this team. <a href="/settings" data-test-id="walkthrough-rule-settings">Settings</a></p>
    <% end %>

    <% record_path = "/teams/#{@team.id}/teamwork/walkthroughs" %>
    <h3 class="section-title">Needs a walkthrough</h3>
    <% if @rule_on %>
      <p class="lens-help" data-test-id="walkthrough-count" data-waiting="<%= @needed.size %>" data-limit="<%= @limit %>"><%= @needed.size %> of <%= @limit %> <%= @limit == 1 ? 'story' : 'stories' %> waiting</p>
    <% end %>
    <% if @needed.any? %>
      <table class="data-table">
        <thead>
          <tr>
            <th>Story</th>
            <th>On it</th>
            <th>Last deployed</th>
            <th>Scenarios</th>
            <th>Who attended</th>
          </tr>
        </thead>
        <tbody>
          <% @needed.each do |row| %>
            <% last_deployed = row.story.last_deployed_at.strftime('%Y-%m-%d') %>
            <tr data-test-id="walkthrough-needed" data-story="<%= row.story.id %>" data-scenarios="<%= row.scenario_count %>" data-last-deployed="<%= last_deployed %>">
              <td><%= row.story.title %></td>
              <td><%= row.on_it.map(&:name).join(', ') %></td>
              <td><%= last_deployed %></td>
              <td><%= row.scenario_count %></td>
              <td>
                <form method="post" action="<%= record_path %>" class="walkthrough-form" data-test-id="walkthrough-form" data-story="<%= row.story.id %>">
                  <%== csrf_tag(record_path) %>
                  <input type="hidden" name="story_id" value="<%= row.story.id %>">
                  <% row.could_attend.each do |person| %>
                    <label class="form-label form-label--checkbox">
                      <input type="checkbox" name="attendee_ids[]" class="form-checkbox" data-test-id="walkthrough-attendee" value="<%= person.id %>">
                      <%= person.name %>
                    </label>
                  <% end %>
                  <button type="submit" class="btn btn-sm" data-test-id="walkthrough-record">Record walkthrough</button>
                </form>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="empty-state" data-test-id="walkthrough-none-needed">No stories are waiting for a walkthrough.</p>
    <% end %>
  </div>

  <div class="teamwork-sidebar">
    <%== render('teams/teamwork/_members') %>
  </div>
</div>
