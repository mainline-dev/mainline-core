<% @page_breadcrumb = 'Teamwork' %>
<%== render('teams/teamwork/_subnav') %>

<div class="teamwork-layout">
  <div class="teamwork-main">
    <h2 class="section-heading" data-test-id="teamwork-page-walkthroughs">Walkthroughs</h2>

    <% unless @rule_on %>
      <p class="lens-help" data-test-id="walkthrough-rule-off">The two-person rule is off for this team. <a href="/settings" data-test-id="walkthrough-rule-settings">Settings</a></p>
    <% end %>

    <h3 class="section-title">Needs a walkthrough</h3>
    <% if @rule_on %>
      <p class="lens-help" data-test-id="walkthrough-count" data-waiting="<%= @needed.size %>" data-limit="<%= @limit %>"><%= @needed.size %> of <%= @limit %> <%= @limit == 1 ? 'story' : 'stories' %> waiting</p>
    <% end %>
    <% if @needed.any? %>
      <table class="data-table">
        <thead>
          <tr>
            <th>Story</th>
            <th>On it</th>
            <th>Last deployed</th>
            <th>Scenarios</th>
            <th>Who attended</th>
          </tr>
        </thead>
        <tbody>
          <% @needed.each do |row| %>
            <% last_deployed = row.story.last_deployed_at.strftime('%Y-%m-%d') %>
            <tr data-test-id="walkthrough-needed" data-story="<%= row.story.id %>" data-scenarios="<%= row.scenario_count %>" data-last-deployed="<%= last_deployed %>" data-kickoff="<%= row.kickoff %>">
              <td>
                <%= row.story.title %>
                <% if row.kickoff == :none %>
                  <span class="card-note-chip note-chip-stale" data-test-id="walkthrough-no-kickoff">No kickoff</span>
                <% end %>
              </td>
              <td><%= row.on_it.map(&:name).join(', ') %></td>
              <td><%= last_deployed %></td>
              <td><%= row.scenario_count %></td>
              <td>
                <%== render('teams/teamwork/_walkthrough_form', locals: { story: row.story, could_attend: row.could_attend }) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="empty-state" data-test-id="walkthrough-none-needed">No stories are waiting for a walkthrough.</p>
    <% end %>

    <h3 class="section-title">Walked, not yet released</h3>
    <% if @walked.any? %>
      <table class="data-table">
        <thead>
          <tr>
            <th>Story</th>
            <th>Attended</th>
          </tr>
        </thead>
        <tbody>
          <% @walked.each do |row| %>
            <tr data-test-id="walked-not-released" data-story="<%= row.story.id %>" data-attended="<%= row.attended.map(&:id).join(',') %>" data-deployed-since="<%= row.deployed_since %>">
              <td>
                <%= row.story.title %>
                <% if row.deployed_since %>
                  <span class="card-note-chip note-chip-stale" data-test-id="walked-deployed-since">Deployed again since the walkthrough</span>
                <% end %>
              </td>
              <td><%= row.attended.map(&:name).join(', ') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="empty-state" data-test-id="walked-none">No walked stories are waiting to be released.</p>
    <% end %>

    <h3 class="section-title">Seen by two people</h3>
    <p class="lens-help">Active, deployed stories that two or more people worked on. For information only.</p>
    <% if @together.any? %>
      <table class="data-table">
        <thead>
          <tr>
            <th>Story</th>
            <th>People</th>
            <th>Who attended</th>
          </tr>
        </thead>
        <tbody>
          <% @together.each do |row| %>
            <tr data-test-id="seen-by-two" data-story="<%= row.story.id %>">
              <td><%= row.story.title %></td>
              <td><%= row.on_it.map(&:name).join(', ') %></td>
              <td><%== render('teams/teamwork/_walkthrough_form', locals: { story: row.story, could_attend: row.could_attend }) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="empty-state" data-test-id="seen-by-two-none">No deployed stories have had two people on them.</p>
    <% end %>
  </div>

  <div class="teamwork-sidebar">
    <%== render('teams/teamwork/_members') %>
  </div>
</div>
