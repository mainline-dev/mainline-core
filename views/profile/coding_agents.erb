<h1 class="page-title">Coding agents</h1>

<div class="banner-info">A coding agent reads the maps and stories of the teams you give it, as you, and changes nothing.</div>

<% if @new_token %>
  <section class="section" data-test-id="new-token-box">
    <h2 class="section-title">Your new token</h2>
    <p class="lens-help">Copy it now. Mainline shows it only this once and keeps only a fingerprint of it.</p>
    <code class="token" data-test-id="new-token"><%= @new_token %></code>

    <%
      endpoint = "#{ENV.fetch('BASE_URL')}/mcp"
      claude_code = "claude mcp add --transport http mainline \\\n  #{endpoint} \\\n  --header \"Authorization: Bearer #{@new_token}\""
      codex = "export MAINLINE_TOKEN=\"#{@new_token}\"\ncodex mcp add mainline --url #{endpoint} \\\n  --bearer-token-env-var MAINLINE_TOKEN"
    %>
    <h3>Connect your coding agent</h3>
    <p>Claude Code: run this in a terminal. <button type="button" class="preview-copy-id" data-copy="<%= claude_code %>" data-agent="claude-code" data-test-id="connect-command">Copy</button></p>
    <pre><%= claude_code %></pre>
    <p>Codex: run this in a terminal. <button type="button" class="preview-copy-id" data-copy="<%= codex %>" data-agent="codex" data-test-id="connect-command">Copy</button></p>
    <pre><%= codex %></pre>
    <p class="muted">Codex reads the token from that variable each time it starts, so set it in your shell profile too.</p>
    <p>Any other agent: give it the address <code><%= endpoint %></code> and send the token in an <code>Authorization: Bearer</code> header.</p>
    <p>Then ask your agent to list your Mainline maps.</p>
  </section>
<% end %>

<% if @app_sign_ins.any? %>
  <section class="section" data-test-id="app-sign-ins">
    <h2 class="section-title">Apps signed in</h2>
    <p class="lens-help">Coding agents you signed in through their app, such as Claude Code or Codex.</p>
    <% @app_sign_ins.each do |app| %>
      <div class="provider-row" data-test-id="app-sign-in" data-id="<%= app.id %>" data-app="<%= app.app %>"
           data-teams="<%= app.teams.join(', ') %>" data-signed-in="<%= app.signed_in_at.getutc.to_date.iso8601 %>"
           data-last-used="<%= app.last_used_at&.getutc&.to_date&.iso8601 %>">
        <span class="provider-name"><%= app.app %></span>
        <span class="muted">
          <%= app.teams.join(', ') %> &middot; signed in <%= app.signed_in_at.strftime('%-d %b %Y') %> &middot;
          <%= app.last_used_at ? "last used #{app.last_used_at.strftime('%-d %b %Y')}" : 'never used' %>
        </span>
        <form method="post" action="/profile/coding-agents/tokens/<%= app.id %>/revoke" class="inline-form">
          <%== csrf_tag("/profile/coding-agents/tokens/#{app.id}/revoke") %>
          <button type="submit" class="btn btn-danger btn-sm" data-test-id="revoke-sign-in">Revoke</button>
        </form>
      </div>
    <% end %>
  </section>
<% end %>

<section class="section">
  <h2 class="section-title">Personal tokens</h2>
  <p class="lens-help">For a coding agent that cannot sign in through a browser, such as one on a build runner.</p>
  <p class="lens-help">To connect an agent with a token, see the <a href="https://mainline.dev/docs/coding-agents" data-test-id="connect-setup-steps">setup steps</a>.</p>

  <% if @personal_tokens.empty? %>
    <p class="lens-help" data-test-id="no-personal-tokens">You have no personal tokens.</p>
  <% end %>
  <% @personal_tokens.each do |token| %>
    <div class="provider-row" data-test-id="personal-token" data-id="<%= token.id %>" data-name="<%= token.name %>"
         data-teams="<%= token.teams.join(', ') %>" data-expires-on="<%= token.expires_on.iso8601 %>"
         data-last-used="<%= token.last_used_at&.getutc&.iso8601 %>">
      <span class="provider-name"><%= token.name %></span>
      <span class="muted">
        <%= token.teams.join(', ') %> &middot; expires <%= token.expires_on.strftime('%-d %b %Y') %> &middot;
        <%= token.last_used_at ? "last used #{token.last_used_at.strftime('%-d %b %Y')}" : 'never used' %>
      </span>
      <form method="post" action="/profile/coding-agents/tokens/<%= token.id %>/revoke" class="inline-form">
        <%== csrf_tag("/profile/coding-agents/tokens/#{token.id}/revoke") %>
        <button type="submit" class="btn btn-danger btn-sm" data-test-id="revoke-token">Revoke</button>
      </form>
    </div>
  <% end %>
</section>

<section class="section">
  <h2 class="section-title">New personal token</h2>
  <% if @token_errors&.any? %>
    <ul class="errors" data-test-id="form-errors"><% @token_errors.each do |e| %><li><%= e %></li><% end %></ul>
  <% end %>
  <div class="form-container">
    <form method="post" action="/profile/coding-agents/tokens" data-test-id="new-token-form">
      <%== csrf_tag('/profile/coding-agents/tokens') %>
      <label for="token-name">Name</label>
      <input type="text" id="token-name" name="name" placeholder="e.g. build runner" maxlength="100" required>

      <label>Teams</label>
      <div class="checkbox-group">
        <% @token_teams.each do |team| %>
          <label>
            <input type="checkbox" name="team_ids[]" value="<%= team.id %>"
                   <%= 'checked' if @ticked_team_ids.include?(team.id) %>
                   data-test-id="token-team" data-team-name="<%= team.name %>">
            <%= team.name %>
          </label>
        <% end %>
      </div>

      <label for="token-expires">Works until</label>
      <input type="date" id="token-expires" name="expires_on" value="<%= @default_expiry.iso8601 %>"
             min="<%= (Date.today + 1).iso8601 %>" max="<%= Date.today.next_year.iso8601 %>" required>

      <button type="submit" class="btn">Create token</button>
    </form>
  </div>
</section>
