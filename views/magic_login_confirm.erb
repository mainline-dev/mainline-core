<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mainline</title>
  <%== og_tags %>
  <%== assets(:css) %>
  <style>@import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap');</style>
</head>
<body class="landing">
<%== render('site/_nav') %>
  <div class="hero">
    <div class="login-brand">Main<em>line</em></div>
    <p class="login-tagline">Where Agile theatre goes to die.</p>
    <div class="login-rule"></div>
    <h2 class="login-heading">Click to sign in</h2>
    <form method="post" action="/magic-login/<%= @magic_token %>" data-test-id="magic-login-confirm">
      <%== csrf_tag("/magic-login/#{@magic_token}") %>
      <button type="submit" class="confirm-btn">Sign in to Mainline</button>
    </form>
  </div>
</body>
</html>
